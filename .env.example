# Admin password (at least 16 characters). Set the real value in the host's
# secret manager / environment; never commit a populated .env file.
# ADMIN_PASSWORD=

# Random signing key (at least 32 characters). Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# ADMIN_SESSION_SECRET=

# Docker already defaults to this path; override for non-container deployments.
# COMPARISON_DB_PATH=/data/comparisons.sqlite
